{
  "env": {
    "TELEGRAM_BOT_TOKEN": "YOUR_TELEGRAM_BOT_TOKEN"
  },
  "models": {
    "providers": {
      "claudible": {
        "baseUrl": "CLAUDIBLE_BASE_URL",
        "apiKey": "YOUR_CLAUDIBLE_API_KEY",
        "api": "openai-completions",
        "models": [
          {
            "id": "claude-sonnet-4.6",
            "name": "Claude Sonnet 4.6",
            "api": "openai-completions",
            "reasoning": false,
            "input": ["text", "image"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 200000,
            "maxTokens": 16384
          },
          {
            "id": "claude-opus-4.6",
            "name": "Claude Opus 4.6",
            "api": "openai-completions",
            "reasoning": false,
            "input": ["text", "image"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 200000,
            "maxTokens": 16384
          },
          {
            "id": "claude-haiku-4.5",
            "name": "Claude Haiku 4.5",
            "api": "openai-completions",
            "reasoning": false,
            "input": ["text", "image"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 200000,
            "maxTokens": 16384
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "claudible/SELECTED_MODEL"
      },
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      }
    }
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "allowlist",
      "allowFrom": ["ALLOWED_CHAT_IDS"],
      "groupPolicy": "allowlist",
      "streaming": "partial",
      "accounts": {
        "default": {
          "dmPolicy": "allowlist",
          "allowFrom": ["ALLOWED_CHAT_IDS"],
          "botToken": "YOUR_TELEGRAM_BOT_TOKEN",
          "groupPolicy": "allowlist",
          "streaming": "partial"
        }
      }
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "lan",
    "trustedProxies": ["172.16.0.0/12", "10.0.0.0/8", "192.168.0.0/16"],
    "controlUi": {
      "allowedOrigins": ["*"]
    },
    "auth": {
      "mode": "token",
      "token": "YOUR_SECRET_TOKEN"
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    }
  },
  "tools": {
    "elevated": {
      "enabled": true
    },
    "exec": {
      "ask": "off"
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      },
      "acpx": {
        "enabled": true
      }
    }
  }
}
